{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mes Enveloppes",
  "version": "1.0.0",
  "identifier": "fr.mesenveloppes.app",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Mes Enveloppes",
        "width": 1200,
        "height": 820,
        "minWidth": 380,
        "minHeight": 560,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": { "languages": ["French"] },
      "wix": { "language": "fr-FR" }
    }
  }
}
